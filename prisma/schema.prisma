// Prisma schema with proper FK cascading, postgres mapping, and reordering

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"] // first one is for cross-platform, second one for docker, last one for serverless environment. safe to include all
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =========================
// Core Entities
// =========================

model User {
  // Identifiers
  id     String @id @default(cuid()) @map("id")
  authId String @unique @map("auth_id")

  // Business fields
  role           UserRole?          @default(user)
  tier           UserTier?          @default(FREE)
  creditsBalance Int                @default(0) @map("credits_balance")
  status         UserAccountStatus? @default(active)
  isOnboarded    Boolean            @default(false)

  // Encryption salt (safe to persist)
  encryptionSalt String? @map("encryption_salt") // Base64 encoded salt for key derivation

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relationships
  auditLogs            AuditLog[]
  config               UserConfig?
  profile              Profile?
  sessions             Session[]
  aiOperations         AiOperationLog[]
  creditTransactions   CreditTransaction[]
  subscriptions        Subscription[]
  subscriptionRenewals SubscriptionRenewal[]

  @@map("users")
}

model Profile {
  // Identifiers
  id String @id @default(cuid())

  // Foreign keys
  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Business fields
  displayName           String?                  @map("display_name")
  ageGroup              AgeGroup?                @map("age_group")
  identityConnection    IdentityConnectionLevel? @map("identity_connection")
  copingMechanism       CopingMechanism?         @map("coping_mechanism")
  socialPressureSources SocialPressureSource[]   @default([]) @map("social_pressure_sources")
  emotionalConcerns     EmotionalConcern[]       @default([]) @map("emotional_concerns")
  emotionalAspirations  EmotionalAspirations[]   @default([]) @map("emotional_aspirations")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("profiles")
}

model UserConfig {
  // Identifiers
  id String @id @default(uuid())

  // Foreign keys
  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Business fields
  autoSave Boolean    @default(false) @map("auto_save")
  theme    ThemeMode? @default(system)
  locale   String?    @default("en")

  // Appearance settings
  fontSize        String? @default("medium") @map("font_size") // "small" | "medium" | "large"
  enableAnimation Boolean @default(false) @map("enable_animation")

  // Future features (not implemented yet, but ready for when needed)
  analyticsOptIn    Boolean @default(false) @map("analytics_opt_in")
  shareImprovements Boolean @default(true) @map("share_improvements")
  marketingEmails   Boolean @default(false) @map("marketing_emails")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user_configs")
}

// =========================
// Activity & Audit
// =========================

model AuditLog {
  // Identifiers
  id String @id @default(cuid())

  // Foreign keys (optional for system-level logs)
  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [authId], onDelete: Cascade)

  // Core logging fields
  operation String // Clean operation name (e.g., "user_signup", "session_create")
  level     LogLevel // Log level enum
  message   String // Human-readable message

  // Context fields
  errorCode String? // Structured error codes
  sessionId String? @map("session_id") // Session correlation
  userAgent String? @map("user_agent") // Client information
  ipAddress String? @map("ip_address") // Request IP

  // Additional context
  metadata Json? // Flexible additional data

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")

  // Indexes for performance
  @@index([userId, createdAt])
  @@index([operation, createdAt])
  @@index([level, createdAt])
  @@index([errorCode])
  @@index([sessionId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Session {
  // Identifiers
  id String @id @default(uuid())

  // Foreign keys
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Core session info (non-encrypted)
  title           String // title of session
  subtitle        String? // subtitle of session
  autoUpdateTitle Boolean @default(false)
  persistOnCloud  Boolean @default(false)

  // Client-visible metadata (minimal, no sensitive data)
  metadata Json // { messageCount: int, creditsUsed: int } - NO token details, NO costs

  // User messages (encrypted with user password)
  messages Json? @map("messages") // { messages: [...] }

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relationships
  aiOperations  AiOperationLog[]
  serverContext SessionContext? // One-to-one: therapeutic data stored separately

  // Performance indexes
  @@index([userId, createdAt])
  @@index([userId, updatedAt])
  @@map("sessions")
}

// Separate table for server-only therapeutic data
// Stored separately for performance (don't load heavy data on session lists)
model SessionContext {
  // Identifiers (one-to-one with Session)
  sessionId String  @id @map("session_id")
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // Server-only therapeutic data (encrypted with APP_ENCRYPTION_KEY)
  // Contains: { analysisSnapshots, aggregatedAnalysis, memoryStore, continuitySummary }
  // NEVER sent to client - only used server-side for continuity
  directives      ReflectionDirective[] // 1:N inside context
  relationalTrace Json?                 @map("relational_trace")
  sessionWellness Json?                 @map("session_wellness")
  factualMemory   Json?                 @map("factual_memory") // encrypted if needed

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Performance indexes
  @@index([sessionId])
  @@map("session_contexts")
}

model ReflectionDirective {
  id        String         @id @default(cuid())
  sessionId String // FK to SessionContext
  context   SessionContext @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)

  intent DirectiveIntent
  stance DirectiveStance
  tone   DirectiveTone

  allow_psychoeducation Boolean
  allow_curiosity       Boolean

  risk_level DirectiveRiskLevel
  crisis     CrisisLevel

  cognitive_patterns   String[]
  emotional_themes     String[]
  distortions_detected String[]
  implicit_needs       String[]

  rationale String @db.Text()

  createdAt DateTime @default(now())
}

// =========================
// AI Operations & Analytics
// =========================

model AiOperationLog {
  // Identifiers
  id String @id @default(cuid())

  // Foreign keys
  userId    String  @map("user_id")
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String  @map("session_id")
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // Operation details
  operation AiOperationType // Type of AI operation
  model     String // AI model used (e.g., "gpt-4o-mini")
  messageId String?         @map("message_id") // Associated message ID (if applicable)

  // Token usage (for billing reconciliation)
  inputTokens  Int @map("input_tokens")
  outputTokens Int @map("output_tokens")
  totalTokens  Int @map("total_tokens")

  // Billing details
  creditsCharged Int   @map("credits_charged") // Credits charged to user
  rawCostUSD     Float @map("raw_cost_usd") // Actual API cost

  // Operational metadata
  metadata Json? // { isRetry, analysisValue, isLightweight, etc. }

  // Timestamp
  timestamp DateTime @default(now())

  // Performance indexes
  @@index([userId, timestamp]) // For user billing reports
  @@index([sessionId, timestamp]) // For session cost breakdown
  @@index([operation, timestamp]) // For operation type analytics
  @@index([timestamp]) // For time-based queries
  @@map("ai_operation_logs")
}

model CreditTransaction {
  // Identifiers
  id String @id @default(cuid())

  // Foreign keys
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Transaction details
  type      CreditTransactionType // CREDIT | DEBIT
  amount    Int // Credits amount (always positive)
  reason    String // "ai_usage", "purchase", "admin_adjustment"
  sessionId String?               @map("session_id") // Link to session if AI usage

  // Metadata for context
  metadata Json? // Additional context (model used, tokens, etc.)

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")

  // Performance indexes
  @@index([userId, createdAt])
  @@index([userId, type, createdAt])
  @@index([reason, createdAt])
  @@index([type])
  @@map("credit_transactions")
}

// =========================
// Subscription Management
// =========================

model Subscription {
  // Identifiers
  id         String @id @default(cuid())
  stripeId   String @unique @map("stripe_id") // Stripe subscription ID
  customerId String @map("customer_id") // Stripe customer ID

  // Foreign keys
  userId String @map("user_id")

  // Subscription details
  status             SubscriptionStatus
  currentPeriodStart DateTime           @map("current_period_start")
  currentPeriodEnd   DateTime           @map("current_period_end")
  cancelAtPeriodEnd  Boolean            @default(false) @map("cancel_at_period_end")
  canceledAt         DateTime?          @map("canceled_at")

  // Plan details
  planId           String @map("plan_id") // Stripe price ID
  creditsPerPeriod Int    @map("credits_per_period")
  priceAmountCents Int    @map("price_amount_cents")
  currency         String @default("usd")

  // Billing
  trialStart DateTime? @map("trial_start")
  trialEnd   DateTime? @map("trial_end")

  // Metadata
  metadata Json @default("{}")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relationships
  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  renewals SubscriptionRenewal[]

  @@map("subscriptions")
}

model SubscriptionRenewal {
  // Identifiers
  id String @id @default(cuid())

  // Foreign keys
  subscriptionId String @map("subscription_id")
  userId         String @map("user_id")

  // Renewal details
  periodStart     DateTime @map("period_start")
  periodEnd       DateTime @map("period_end")
  creditsGranted  Int      @map("credits_granted")
  amountPaidCents Int      @map("amount_paid_cents")

  // Stripe details
  invoiceId       String? @map("invoice_id") // Stripe invoice ID
  paymentIntentId String? @map("payment_intent_id") // Stripe payment intent ID

  // Status
  status      RenewalStatus @default(pending)
  processedAt DateTime?     @map("processed_at")

  // Metadata
  metadata Json @default("{}")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relationships
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscription_renewals")
}

// =========================
// Enums
// =========================

enum AiOperationType {
  DIRECTIVE // User input analysis
  MEMORY_ANALYSIS // Memory extraction/recall
  REFLECTION // Reflection stage (GPT-4o)
  SESSION_WELLNESS // Session wellness check
}

enum LogLevel {
  INFO
  WARN
  ERROR
  AUDIT
}

enum CreditTransactionType {
  CREDIT // User receives credits (purchase, bonus, refund)
  DEBIT // User spends credits (AI usage)
}

enum UserRole {
  admin
  user
  tester
}

enum AgeGroup {
  Age18_24
  Age25_34
  Age35_44
  Age45_54
  Age55Plus
}

enum IdentityConnectionLevel {
  authentic
  conflicted
  disconnected
  lost
}

enum CopingMechanism {
  shutdown
  self_critical
  overwhelmed
  push_through
}

enum SocialPressureSource {
  family
  friends
  work_or_school
  romantic
  cultural_or_religious
  self
}

enum EmotionalConcern {
  anxiety
  self_worth
  overthinking
  loneliness
  burnout
  mood_swings
  identity_crisis
  other
}

enum EmotionalAspirations {
  clarity
  calm
  confidence
  self_compassion
  connection
  direction
  not_sure
}

enum ThemeMode {
  light
  dark
  system
}

enum UserAccountStatus {
  active
  inactive
  deleted
  locked
  banned
}

enum SubscriptionStatus {
  active
  past_due
  canceled
  unpaid
  paused
  trialing
  incomplete
  incomplete_expired
}

enum RenewalStatus {
  pending
  processed
  failed
  skipped
}

enum UserTier {
  FREE
  STARTER
  REGULAR
  PREMIUM
}

// Directives Enums
enum DirectiveIntent {
  contain
  validate
  gently_explore
  reframe
  anchor
}

enum DirectiveStance {
  grounding
  steady
  exploratory
  nurturing
  directive
}

enum DirectiveTone {
  calm
  warm
  curious
  firm
  light
}

enum DirectiveRiskLevel {
  none
  low
  moderate
}

enum CrisisLevel {
  none
  mild
  moderate
  high
  immediate
}
