// Prisma schema with proper FK cascading, postgres mapping, and reordering

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"] // first one is for cross-platform, second one for docker, last one for serverless environment. safe to include all
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =========================
// Core Entities
// =========================

model User {
  // Identifiers
  id     String @id @default(cuid()) @map("id")
  authId String @unique @map("auth_id")

  // Business fields
  role           UserRole?          @default(user)
  creditsBalance Int                @default(0) @map("credits_balance")
  status         UserAccountStatus? @default(active)
  isOnboarded    Boolean            @default(false)

  // Encryption salt (safe to persist)
  encryptionSalt String? @map("encryption_salt") // Base64 encoded salt for key derivation

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relationships
  auditLogs            AuditLog[]
  config               UserConfig?
  profile              Profile?
  sessions             Session[]
  creditTransactions   CreditTransaction[]
  subscriptions        Subscription[]
  subscriptionRenewals SubscriptionRenewal[]

  @@map("users")
}

model Profile {
  // Identifiers
  id String @id @default(cuid())

  // Foreign keys
  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Business fields
  displayName           String?                  @map("display_name")
  ageGroup              AgeGroup?                @map("age_group")
  identityConnection    IdentityConnectionLevel? @map("identity_connection")
  copingMechanism       CopingMechanism?         @map("coping_mechanism")
  socialPressureSources SocialPressureSource[]   @default([]) @map("social_pressure_sources")
  emotionalConcerns     EmotionalConcern[]       @default([]) @map("emotional_concerns")
  emotionalAspirations  EmotionalAspirations[]   @default([]) @map("emotional_aspirations")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("profiles")
}

model UserConfig {
  // Identifiers
  id String @id @default(uuid())

  // Foreign keys
  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Business fields
  autoSave Boolean    @default(false) @map("auto_save")
  theme    ThemeMode? @default(system)
  locale   String?    @default("en")

  // Appearance settings
  fontSize        String?  @default("medium") @map("font_size") // "small" | "medium" | "large"
  enableAnimation Boolean  @default(false) @map("enable_animation")

  // Future features (not implemented yet, but ready for when needed)
  analyticsOptIn    Boolean @default(false) @map("analytics_opt_in")
  shareImprovements Boolean @default(true) @map("share_improvements")
  marketingEmails   Boolean @default(false) @map("marketing_emails")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user_configs")
}

// =========================
// Activity & Audit
// =========================

model AuditLog {
  // Identifiers
  id String @id @default(cuid())

  // Foreign keys (optional for system-level logs)
  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [authId], onDelete: Cascade)

  // Core logging fields
  operation String // Clean operation name (e.g., "user_signup", "session_create")
  level     LogLevel // Log level enum
  message   String // Human-readable message

  // Context fields
  errorCode String? // Structured error codes
  sessionId String? @map("session_id") // Session correlation
  userAgent String? @map("user_agent") // Client information
  ipAddress String? @map("ip_address") // Request IP

  // Additional context
  metadata Json? // Flexible additional data

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")

  // Indexes for performance
  @@index([userId, createdAt])
  @@index([operation, createdAt])
  @@index([level, createdAt])
  @@index([errorCode])
  @@index([sessionId])
  @@index([createdAt])
  @@map("audit_logs")
}

enum LogLevel {
  INFO
  WARN
  ERROR
  AUDIT
}

model Session {
  // Identifiers
  id String @id @default(uuid())

  // Foreign keys
  userId          String    @map("user_id")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Core session info (non-encrypted)
  title           String // title of session
  subtitle        String? // subtitle of session
  autoUpdateTitle Boolean   @default(false)
  persistOnCloud  Boolean   @default(true) @map("persist_on_cloud") // user consent for cloud backup
  metadata        Json // additional metadata { messageCount: int, tokenCount: int, creditsUsed: int }

  // Server-only analytics (never sent to client - used for billing verification and debugging)
  serverAnalytics Json?     @map("server_analytics") // { tokenUsageBreakdown: [...], operationMetrics: {...} }

  // Encrypted session bundle
  encryptedData   Json?     @map("encrypted_data")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Performance indexes
  @@index([userId, createdAt])
  @@index([userId, updatedAt])
  @@map("sessions")
}

model CreditTransaction {
  // Identifiers
  id String @id @default(cuid())

  // Foreign keys
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Transaction details
  type      CreditTransactionType // CREDIT | DEBIT
  amount    Int // Credits amount (always positive)
  reason    String // "ai_usage", "purchase", "admin_adjustment"
  sessionId String?               @map("session_id") // Link to session if AI usage

  // Metadata for context
  metadata Json? // Additional context (model used, tokens, etc.)

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")

  // Performance indexes
  @@index([userId, createdAt])
  @@index([userId, type, createdAt])
  @@index([reason, createdAt])
  @@index([type])
  @@map("credit_transactions")
}

model Tester {
  // Identifiers
  id String @id @default(cuid())

  // Tester info
  email      String  @unique
  accepted   Boolean @default(false) // has this tester been approved to join
  source     String? @map("source") // homepage, invite link, etc.
  occupation String? // optional: what she does in life
  struggles  String? // optional: general struggles / pain points
  coping     String? // optional: what she does to cope
  notes      String? // internal admin notes

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([email])
  @@map("testers")
}

// =========================
// Subscription Management
// =========================

model Subscription {
  // Identifiers
  id         String @id @default(cuid())
  stripeId   String @unique @map("stripe_id") // Stripe subscription ID
  customerId String @map("customer_id") // Stripe customer ID

  // Foreign keys
  userId String @map("user_id")

  // Subscription details
  status             SubscriptionStatus
  currentPeriodStart DateTime           @map("current_period_start")
  currentPeriodEnd   DateTime           @map("current_period_end")
  cancelAtPeriodEnd  Boolean            @default(false) @map("cancel_at_period_end")
  canceledAt         DateTime?          @map("canceled_at")

  // Plan details
  planId           String @map("plan_id") // Stripe price ID
  creditsPerPeriod Int    @map("credits_per_period")
  priceAmountCents Int    @map("price_amount_cents")
  currency         String @default("usd")

  // Billing
  trialStart DateTime? @map("trial_start")
  trialEnd   DateTime? @map("trial_end")

  // Metadata
  metadata Json @default("{}")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relationships
  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  renewals SubscriptionRenewal[]

  @@map("subscriptions")
}

model SubscriptionRenewal {
  // Identifiers
  id String @id @default(cuid())

  // Foreign keys
  subscriptionId String @map("subscription_id")
  userId         String @map("user_id")

  // Renewal details
  periodStart     DateTime @map("period_start")
  periodEnd       DateTime @map("period_end")
  creditsGranted  Int      @map("credits_granted")
  amountPaidCents Int      @map("amount_paid_cents")

  // Stripe details
  invoiceId       String? @map("invoice_id") // Stripe invoice ID
  paymentIntentId String? @map("payment_intent_id") // Stripe payment intent ID

  // Status
  status      RenewalStatus @default(pending)
  processedAt DateTime?     @map("processed_at")

  // Metadata
  metadata Json @default("{}")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relationships
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscription_renewals")
}

// =========================
// Enums
// =========================

enum CreditTransactionType {
  CREDIT // User receives credits (purchase, bonus, refund)
  DEBIT // User spends credits (AI usage)
}

enum UserRole {
  admin
  user
  tester
}

enum AgeGroup {
  Age18_24
  Age25_34
  Age35_44
  Age45_54
  Age55Plus
}

enum IdentityConnectionLevel {
  authentic
  conflicted
  disconnected
  lost
}

enum CopingMechanism {
  shutdown
  self_critical
  overwhelmed
  push_through
}

enum SocialPressureSource {
  family
  friends
  work_or_school
  romantic
  cultural_or_religious
  self
}

enum EmotionalConcern {
  anxiety
  self_worth
  overthinking
  loneliness
  burnout
  mood_swings
  identity_crisis
  other
}

enum EmotionalAspirations {
  clarity
  calm
  confidence
  self_compassion
  connection
  direction
  not_sure
}

enum ThemeMode {
  light
  dark
  system
}

enum UserAccountStatus {
  active
  inactive
  deleted
  locked
  banned
}

enum SubscriptionStatus {
  active
  past_due
  canceled
  unpaid
  paused
  trialing
  incomplete
  incomplete_expired
}

enum RenewalStatus {
  pending
  processed
  failed
  skipped
}
